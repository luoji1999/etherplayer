<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HighlightBorder" TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="CornerRadius" Value="{DynamicResource MainCornerRadius}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DefaultControlBorders}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LightGrey}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource White}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource White}" />
            </Trigger>
        </Style.Triggers>
    </Style>                  
</ResourceDictionary>