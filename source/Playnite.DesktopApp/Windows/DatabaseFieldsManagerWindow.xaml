<controls:WindowBase x:Class="Playnite.DesktopApp.Windows.DatabaseFieldsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:Playnite;assembly=ETPlayer"
        xmlns:controls="clr-namespace:Playnite.Controls;assembly=ETPlayer"
        xmlns:pcon="clr-namespace:Playnite.Converters;assembly=ETPlayer"
        xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=ETPlayer"
        xmlns:pctrls="clr-namespace:Playnite.DesktopApp.Controls"
        mc:Ignorable="d"
        Style="{DynamicResource StandardWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{DynamicResource LOCDatabaseFieldsWindowTitle}"
        Width="830" Height="600"
        AutomationProperties.AutomationId="WindowDatabaseFieldsManager"
        x:Name="WindowDatabaseFieldsManager">

    <controls:WindowBase.Resources>
        <pcon:NullToBoolConverter x:Key="NullToBoolConverter" />
        <pcon:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    </controls:WindowBase.Resources>

    <DockPanel>
        <DockPanel.Resources>
            <p:BindingProxy x:Key="Proxy" Data="{Binding}" />
        </DockPanel.Resources>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource WindowPanelSeparatorBrush}">
            <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="False" Margin="5">
                <Button TabIndex="2" Name="ButtonCancel" Content="{DynamicResource LOCCancelLabel}" DockPanel.Dock="Right"
                        IsCancel="True" Style="{StaticResource BottomButton}"
                        Command="{Binding CancelCommand}"/>
                <Button TabIndex="1" Name="ButtonOK" Content="{DynamicResource LOCSaveLabel}" DockPanel.Dock="Right"
                        Style="{StaticResource BottomButton}" 
                        Command="{Binding SaveCommand}"/>
            </DockPanel>
        </Border>

        <TabControl DockPanel.Dock="Top" Name="TabMain">
            <!-- Categories Tab -->
            <TabItem Header="{DynamicResource LOCCategoriesLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddCategoryCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameCategoryCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCategories}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveCategoryCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCategories}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedCategoriesCommand}" />
                    </DockPanel>
                    <ListBox Name="ListCategories" ItemsSource="{Binding EditingCategories}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Genres Tab -->
            <TabItem Header="{DynamicResource LOCGenresLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddGenreCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameGenreCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListGenres}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveGenreCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListGenres}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedGenresCommand}" />
                    </DockPanel>
                    <ListBox Name="ListGenres" ItemsSource="{Binding EditingGenres}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Companies Tab -->
            <TabItem Header="{DynamicResource LOCCompaniesLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddCompanyCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameCompanyCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCompanies}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveCompanyCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCompanies}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedCompaniesCommand}" />
                    </DockPanel>
                    <ListBox Name="ListCompanies" ItemsSource="{Binding EditingCompanies}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Tags Tab -->
            <TabItem Header="{DynamicResource LOCTagsLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddTagCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameTagCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListTags}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveTagCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListTags}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedTagsCommand}" />
                    </DockPanel>
                    <ListBox Name="ListTags" ItemsSource="{Binding EditingTags}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Features Tab -->
            <TabItem Header="{DynamicResource LOCFeaturesLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddFeatureCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameFeatureCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFeatures}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveFeatureCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFeatures}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedFeaturesCommand}" />
                    </DockPanel>
                    <ListBox Name="ListFeatures" ItemsSource="{Binding EditingFeatures}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Platforms Tab -->
            <TabItem Header="{DynamicResource LOCPlatformsTitle}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddPlatformCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenamePlatformCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemovePlatformCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedPlatformsCommand}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Name="ListPlatforms" Grid.Column="0" Margin="0,0,10,0"
                                 ItemsSource="{Binding EditingPlatforms}"
                                 DisplayMemberPath="Name" SelectionMode="Extended"
                                 pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                        <controls:GridEx Grid.Column="1" AutoLayoutColumns="2" StarColumns="1" ColumnCount="2" RowCount="5"
                                         IsEnabled="{Binding SelectedItem, ElementName=ListPlatforms, Converter={StaticResource NullToBoolConverter}}"
                                         DataContext="{Binding SelectedItem, ElementName=ListPlatforms}">
                            <controls:GridEx.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,5,10,5" />
                                </Style>
                            </controls:GridEx.Resources>
                            <TextBlock Text="{DynamicResource LOCNameLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource LOCSpecificationLabel}" />
                            <ComboBox VerticalAlignment="Center" DisplayMemberPath="Name"
                                      ItemsSource="{Binding Data.PlatformsSpecifications, Source={StaticResource Proxy}}"
                                      SelectedValue="{Binding SpecificationId}"
                                      SelectedValuePath="Id" />
                            <TextBlock Text="{DynamicResource LOCIconLabel}" />
                            <DockPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource LOCSelectIconTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.SelectPlatformIconCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <Button Content="{DynamicResource LOCRemoveTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.RemovePlatformIconCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <TextBox Text="{Binding Icon}" IsReadOnly="True"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource LOCCoverLabel}" />
                            <DockPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource LOCSelectCoverTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.SelectPlatformCoverCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <Button Content="{DynamicResource LOCRemoveTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.RemovePlatformCoverCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <TextBox Text="{Binding Cover}" IsReadOnly="True"/>
                            </DockPanel>
                            <TextBlock Text="{DynamicResource LOCBackgroundLabel}" />
                            <DockPanel VerticalAlignment="Center">
                                <Button Content="{DynamicResource LOCSelectBackgroundTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.SelectPlatformBackgroundCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <Button Content="{DynamicResource LOCRemoveTitle}" DockPanel.Dock="Right" Margin="5,0,0,0"
                                        Command="{Binding Data.RemovePlatformBackgroundCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding SelectedItems, ElementName=ListPlatforms}"/>
                                <TextBox Text="{Binding Background}" IsReadOnly="True"/>
                            </DockPanel>
                        </controls:GridEx>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Series Tab -->
            <TabItem Header="{DynamicResource LOCSeriesLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddSeriesCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameSeriesCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListSeries}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveSeriesCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListSeries}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedSeriesCommand}" />
                    </DockPanel>
                    <ListBox Name="ListSeries" ItemsSource="{Binding EditingSeries}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Age Ratings Tab -->
            <TabItem Header="{DynamicResource LOCAgeRatingsLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddAgeRatingCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameAgeRatingCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListAgeRatings}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveAgeRatingCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListAgeRatings}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedAgeRatingsCommand}" />
                    </DockPanel>
                    <ListBox Name="ListAgeRatings" ItemsSource="{Binding EditingAgeRatings}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Regions Tab -->
            <TabItem Header="{DynamicResource LOCRegionsLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddRegionCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameRegionCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListRegions}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveRegionCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListRegions}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedRegionsCommand}" />
                    </DockPanel>
                    <ListBox Name="ListRegions" ItemsSource="{Binding EditingRegions}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Sources Tab -->
            <TabItem Header="{DynamicResource LOCSourcesLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddSourceCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameSourceCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListSources}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveSourceCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListSources}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedSourcesCommand}" />
                    </DockPanel>
                    <ListBox Name="ListSources" ItemsSource="{Binding EditingSources}"
                             DisplayMemberPath="Name" SelectionMode="Extended"
                             pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                </DockPanel>
            </TabItem>

            <!-- Completion Statuses Tab -->
            <TabItem Header="{DynamicResource LOCCompletionStatus}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCAddTitle}" Command="{Binding AddCompletionStatusCommand}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameCompletionStatusCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCompletionStatuses}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveCompletionStatusCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListCompletionStatuses}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveUnusedLabel}" Command="{Binding RemoveUnusedCompletionStatusesCommand}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Name="ListCompletionStatuses" Grid.Column="0" Margin="0,0,10,0"
                                 ItemsSource="{Binding EditingCompletionStatuses}"
                                 DisplayMemberPath="Name" SelectionMode="Extended"
                                 pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource LOCCompletionStatusSettings}" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource LOCDefaultStatusPlayedLabel}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding CompletionStatusesSelection}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding CompletionStatusSettings.DefaultStatus}" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource LOCDefaultStatusPlayingLabel}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding CompletionStatusesSelection}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding CompletionStatusSettings.PlayedStatus}" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Filter Presets Tab -->
            <TabItem Header="{DynamicResource LOCFilterPresetsLabel}">
                <DockPanel Margin="10">
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                        <Button Content="{DynamicResource LOCRenameTitle}" Command="{Binding RenameFilterPresetCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFilterPresets}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCRemoveTitle}" Command="{Binding RemoveFilterPresetCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFilterPresets}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCMoveUpLabel}" Command="{Binding MoveUpFilterPresetCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFilterPresets}" Margin="0,0,5,0"/>
                        <Button Content="{DynamicResource LOCMoveDownLabel}" Command="{Binding MoveDownFilterPresetCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=ListFilterPresets}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListBox Name="ListFilterPresets" Grid.Column="0" Margin="0,0,10,0"
                                 ItemsSource="{Binding EditingFilterPresets}"
                                 DisplayMemberPath="Name" SelectionMode="Extended"
                                 pbeh:ScrollToSelectedBehavior.Enabled="True"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource LOCFilterPresetsSettings}" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource LOCDefaultFilterPresetLabel}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding EditingFilterPresets}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding FilterPresetsSettings.StartupPresetId}" Margin="0,0,0,10"/>
                            <CheckBox Content="{DynamicResource LOCShowFilterPresetsInSidebar}"
                                      IsChecked="{Binding FilterPresetsSettings.ShowOnSidebar}" Margin="0,0,0,5"/>
                            <CheckBox Content="{DynamicResource LOCShowFilterPresetsInTopPanel}"
                                      IsChecked="{Binding FilterPresetsSettings.ShowOnTopPanel}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</controls:WindowBase>
